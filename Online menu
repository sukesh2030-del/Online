<!-- DRAWER -->
<div id="overlay" class="overlay fixed inset-0 z-50 bg-black/70"></div>
<section id="drawer" class="drawer fixed left-0 right-0 bottom-0 z-50 bg-bg border-t border-line rounded-t-2xl max-h-[92vh] flex flex-col" role="dialog" aria-label="Your cart">
  <div class="max-w-2xl w-full mx-auto flex flex-col min-h-0">
    <div class="flex items-center justify-between px-4 py-3 border-b border-line">
      <h2 class="font-head font-bold text-xl">Aapka Order</h2>
      <button id="closeCart" aria-label="Close cart" class="p-2 rounded-full bg-card"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>

    <div class="overflow-y-auto px-4 py-3 min-h-0" style="padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));">
      <div id="cartItems" class="divide-y divide-line"></div>

      <div class="flex justify-between items-center py-3 border-t border-line mt-1">
        <span class="font-semibold">Total Amount</span>
        <span class="font-head font-extrabold text-2xl text-saffron">₹<span id="cartTotal">0</span></span>
