  { id:48, cat:"North Indian", name:"Aloo Fry With Paratha", desc:"Aloo fry aur garam paratha", price:129 },
  { id:49, cat:"North Indian", name:"Thali", desc:"Dal, chawal, 4 roti, aloo matar ki sabji aur salad", price:139 },
  { id:50, cat:"North Indian", name:"Special Thali", desc:"Dal, chawal, 4 roti, matar paneer ki sabji, salad aur raita", price:169 },
  { id:51, cat:"North Indian", name:"Deluxe Thali", desc:"Dal, chawal, 4 roti, matar paneer, sukhi sabji, salad, raita aur meetha achar", price:229 },
  { id:52, cat:"North Indian", name:"Jain Poori Sabji Thali", desc:"Bina pyaaz-lehsun, poori aur sabji", price:119 },
  { id:53, cat:"North Indian", name:"Tawa Roti", desc:"Garam tawa roti", price:19 },
  { id:54, cat:"North Indian", name:"Tawa Roti Butter", desc:"Makkhan lagi tawa roti", price:29 },
  { id:55, cat:"North Indian", name:"Boondi Raita", desc:"Thanda dahi, boondi ke saath", price:29 },
  { id:56, cat:"North Indian", name:"Curd", desc:"Taaza dahi", price:29 },
  { id:57, cat:"North Indian", name:"Salad", desc:"Pyaaz, kheera, tamatar, nimbu", price:29 }
];

// ---- DISCOUNT RULE ----
// Menu ki base price par DISCOUNT_PERCENT lagta hai, phir price sabse nazdeeki "9 wali" price par set hoti hai (49, 59, 69 ... 199).
// Koi cut-price / MRP nahi dikhta, sirf final price. MIN_PRICE_FOR_DISCOUNT se sasti items par discount nahi lagta.
// Discount badalna ho toh sirf DISCOUNT_PERCENT badlein (0 = koi discount nahi).
const DISCOUNT_PERCENT = 10;
const MIN_PRICE_FOR_DISCOUNT = 50;
function finalPrice(base) {
  if (!DISCOUNT_PERCENT || base < MIN_PRICE_FOR_DISCOUNT) return base;
  const raw = base * (1 - DISCOUNT_PERCENT / 100);
  let p = Math.round((raw - 9) / 10) * 10 + 9;   // nearest number ending in 9
  if (p >= base) p = base - 10;                  // hamesha base se kam
  return Math.max(p, 9);
}
MENU.forEach(m => { m.price = finalPrice(m.price); });

const CATS = ["All", "Fast Food", "North Indian", "Snacks"];
let activeCat = "All";
const cart = {}; // id -> qty

const $ = id => document.getElementById(id);
const byId = id => MENU.find(m => m.id === id);
const totalQty = () => Object.values(cart).reduce((a,b) => a+b, 0);
const totalAmt = () => Object.entries(cart).reduce((s,[id,q]) => s + byId(+id).price * q, 0);

function renderTabs() {
  $("tabs").innerHTML = CATS.map(c => `
    <button data-cat="${c}" class="shrink-0 px-4 py-1.5 rounded-full text-sm font-semibold border ${c===activeCat ? 'bg-saffron text-bg border-saffron' : 'bg-card text-cream border-line'}">${c}</button>`).join("");
  $("tabs").querySelectorAll("button").forEach(b => b.onclick = () => { activeCat = b.dataset.cat; renderTabs(); renderMenu(); });
}

function qtyControl(id) {
  const q = cart[id] || 0;
  if (!q) return `<button data-add="${id}" class="flex items-center gap-1 bg-saffron text-bg font-bold rounded-lg px-4 py-1.5 text-sm"><i data-lucide="plus" class="w-4 h-4"></i> Add</button>`;
  return `<div class="flex items-center gap-3 bg-card border border-saffron rounded-lg px-1 py-1">
    <button data-sub="${id}" aria-label="Kam karein" class="w-7 h-7 flex items-center justify-center text-saffron"><i data-lucide="minus" class="w-4 h-4"></i></button>
    <span class="font-bold w-4 text-center">${q}</span>
    <button data-add="${id}" aria-label="Badhayein" class="w-7 h-7 flex items-center justify-center text-saffron"><i data-lucide="plus" class="w-4 h-4"></i></button>
  </div>`;
}

function renderMenu() {
  const items = MENU.filter(m => activeCat === "All" || m.cat === activeCat);
  $("menu").innerHTML = items.map(m => `
    <article class="bg-card border border-line rounded-xl p-3.5 flex items-center justify-between gap-3">
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <span class="w-3.5 h-3.5 border border-green-500 flex items-center justify-center shrink-0"><span class="w-1.5 h-1.5 rounded-full bg-green-500"></span></span>
          <h3 class="font-head font-bold text-lg leading-tight">${m.name}</h3>
        </div>
        <p class="text-mute text-sm mt-1">${m.desc}</p>
        <p class="font-head font-extrabold text-xl text-saffron mt-1.5">₹${m.price}</p>
      </div>
      <div class="shrink-0" id="ctl-${m.id}">${qtyControl(m.id)}</div>
    </article>`).join("");
  bindControls($("menu"));
  lucide.createIcons();
}

function bindControls(root) {
  root.querySelectorAll("[data-add]").forEach(b => b.onclick = () => change(+b.dataset.add, 1));
  root.querySelectorAll("[data-sub]").forEach(b => b.onclick = () => change(+b.dataset.sub, -1));
}

function change(id, d) {
  const q = (cart[id] || 0) + d;
  if (q <= 0) delete cart[id]; else cart[id] = q;
  const ctl = $("ctl-" + id);
  if (ctl) { ctl.innerHTML = qtyControl(id); bindControls(ctl); }
  update();
}

function update() {
  const n = totalQty();
  $("cartBar").classList.toggle("hidden", n === 0);
  $("barCount").textContent = n + (n === 1 ? " item" : " items");
  $("barTotal").textContent = totalAmt();
  renderCart();
  lucide.createIcons();
  if (n === 0) closeDrawer();
}

function renderCart() {
  $("cartTotal").textContent = totalAmt();
  $("cartItems").innerHTML = Object.entries(cart).map(([id, q]) => {
    const m = byId(+id);
    return `<div class="flex items-center justify-between gap-3 py-2.5">
      <div class="min-w-0">
        <p class="font-semibold leading-tight">${m.name}</p>
        <p class="text-mute text-sm">₹${m.price} × ${q} = ₹${m.price * q}</p>
      </div>
      <div class="flex items-center gap-3 bg-card border border-line rounded-lg px-1 py-1 shrink-0">
        <button data-sub="${id}" aria-label="Kam karein" class="w-7 h-7 flex items-center justify-center text-saffron"><i data-lucide="minus" class="w-4 h-4"></i></button>
        <span class="font-bold w-4 text-center">${q}</span>
        <button data-add="${id}" aria-label="Badhayein" class="w-7 h-7 flex items-center justify-center text-saffron"><i data-lucide="plus" class="w-4 h-4"></i></button>
      </div>
    </div>`;
  }).join("");
  bindControls($("cartItems"));
}

function openDrawer() { $("drawer").classList.add("open"); $("overlay").classList.add("open"); document.body.style.overflow = "hidden"; }
function closeDrawer() { $("drawer").classList.remove("open"); $("overlay").classList.remove("open"); document.body.style.overflow = ""; }

function showErr(msg) { const e = $("err"); e.textContent = msg; e.classList.remove("hidden"); }

function sendOrder() {
  const name = $("custName").value.trim();
  const addr = $("custAddr").value.trim();
  const pay = "Online Payment (UPI)";
  $("err").classList.add("hidden");
  if (!totalQty()) return showErr("Cart khaali hai. Pehle kuch item add karein.");
  if (!name) { $("custName").focus(); return showErr("Kripya apna naam likhein."); }
  if (addr.length < 8) { $("custAddr").focus(); return showErr("Kripya poora delivery address likhein."); }

  const lines = Object.entries(cart).map(([id, q], i) => {
    const m = byId(+id);
    return `${i + 1}. ${m.name} x ${q} = ₹${m.price * q}`;
  });
  const msg =
`*🍽️ NEW ORDER – A2 Restaurant*
━━━━━━━━━━━━━━━
${lines.join("\n")}
━━━━━━━━━━━━━━━
*Total Items:* ${totalQty()}
*Total Amount:* ₹${totalAmt()}

*👤 Customer Details*
Naam: ${name}
Address: ${addr}
Payment: ${pay}

Kripya order confirm karke UPI payment link / QR bhejein. Dhanyavaad! 🙏`;

  window.open(`https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(msg)}`, "_blank");
}

$("openCart").onclick = openDrawer;
$("closeCart").onclick = closeDrawer;
$("overlay").onclick = closeDrawer;
$("waBtn").onclick = sendOrder;
document.addEventListener("keydown", e => { if (e.key === "Escape") closeDrawer(); });

renderTabs();
renderMenu();
update();
</script>
</body>
</html>
