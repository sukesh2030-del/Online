          <label for="custAddr" class="text-sm text-mute">Delivery Address</label>
          <textarea id="custAddr" rows="3" autocomplete="street-address" placeholder="Ghar/Dukaan no., gali, landmark, shehar" class="w-full mt-1 bg-card border border-line rounded-lg px-3 py-2.5 text-cream placeholder-mute/60"></textarea>
        </div>
        <div class="flex items-start gap-2 border border-saffron/50 bg-saffron/10 rounded-lg px-3 py-2.5 text-sm">
          <i data-lucide="smartphone" class="w-4 h-4 mt-0.5 shrink-0 text-saffron"></i>
          <p><span class="font-semibold">Payment: Sirf Online (UPI)</span><br><span class="text-mute">Order confirm hote hi WhatsApp par UPI QR / payment link bheja jayega. Cash on Delivery available nahi hai.</span></p>
        </div>
        <p id="err" class="text-chili text-sm hidden"></p>
        <button id="waBtn" class="w-full flex items-center justify-center gap-2 bg-[#25D366] text-black font-head font-bold text-lg rounded-xl py-3.5">
          <i data-lucide="message-circle" class="w-5 h-5"></i> Order on WhatsApp
