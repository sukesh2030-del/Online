</style>
</head>
<body class="font-body">

<!-- HEADER -->
<header class="px-4 pt-6 pb-4 border-b border-line" style="padding-top: calc(1.5rem + env(safe-area-inset-top, 0px));">
  <div class="max-w-2xl mx-auto flex items-center justify-between gap-3">
    <div>
      <h1 class="font-head font-extrabold text-3xl leading-none text-saffron">A2 Restaurant</h1>
