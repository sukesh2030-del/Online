      <div class="space-y-3 mt-2">
        <div>
          <label for="custName" class="text-sm text-mute">Aapka Naam</label>
          <input id="custName" type="text" autocomplete="name" placeholder="Jaise: Rahul Sharma" class="w-full mt-1 bg-card border border-line rounded-lg px-3 py-2.5 text-cream placeholder-mute/60">
        </div>
